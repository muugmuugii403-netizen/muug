# Forex Analyzer backend — environment загвар.
# Ашиглалт: cp .env.example .env  (make setup үүнийг автоматаар хийнэ)
# .env файлыг ХЭЗЭЭ Ч git-д commit хийхгүй!

# ---- App ----
APP_ENV=dev
DEBUG=true
# prod-д заавал урт, санамсаргүй утгаар солино (config.py default утгыг prod-д блоклож validate хийдэг)
SECRET_KEY=dev-only-secret-change-me
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Database / cache (Step 2-оос ашиглагдана) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forex_analyzer
REDIS_URL=redis://localhost:6379/0

# ---- Market data provider (Twelve Data · Step 2) ----
# Key: https://twelvedata.com/account/api-keys (free: 8 credit/мин, 800/өдөр)
# Хоосон үед локал dev-д детерминист SAMPLE өгөгдөл ашиглагдана (source="sample").
# API key-г ХЭЗЭЭ Ч frontend руу бүү гарга — дуудлага зөвхөн backend-ээс явна.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
SAMPLE_FALLBACK_ENABLED=true
# In-memory TTL cache (секунд) — provider credit хэмнэнэ
MARKET_DATA_CACHE_CANDLES_S=30
MARKET_DATA_CACHE_QUOTE_S=15

# ---- Qwen AI (Step 4, зөвхөн тайлбар — signal гаргахгүй) ----
# Key: https://dashscope.console.aliyun.com/ (compatible-mode)
# Хоосон үед AI тайлбар идэвхгүй (ai_status=disabled), signal engine хэвийн ажиллана.
# API key-г ХЭЗЭЭ Ч frontend руу бүү гарга — дуудлага зөвхөн backend-ээс явна.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_S=20
# Ижил signal-д дахин AI дуудахгүй байх cache (секунд)
QWEN_CACHE_TTL_S=900

# ---- Resilience ----
MARKET_DATA_TIMEOUT_S=8
MARKET_DATA_RETRIES=3
