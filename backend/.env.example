# Forex Analyzer backend — environment загвар.
# Ашиглалт: cp .env.example .env  (make setup үүнийг автоматаар хийнэ)
# .env файлыг ХЭЗЭЭ Ч git-д commit хийхгүй!

# ---- App ----
APP_ENV=dev
DEBUG=true
# prod-д заавал урт, санамсаргүй утгаар солино (config.py default утгыг prod-д блоклож validate хийдэг)
SECRET_KEY=dev-only-secret-change-me
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Database / cache (Step 2-оос ашиглагдана) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forex_analyzer
REDIS_URL=redis://localhost:6379/0

# ---- Market data provider (Step 2) — одоохондоо хоосон ----
TWELVE_DATA_API_KEY=

# ---- Qwen AI (Step 5, зөвхөн тайлбар) — одоохондоо хоосон ----
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_S=20

# ---- Resilience ----
MARKET_DATA_TIMEOUT_S=8
MARKET_DATA_RETRIES=3
