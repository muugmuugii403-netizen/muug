# Frontend-ээс backend руу хандах суурь URL.
# Ашиглалт: cp .env.example .env.local
#
# АНХААРУУЛГА: NEXT_PUBLIC_ эхлэлтэй хувьсагч client bundle-д орно.
# API key / secret утгыг энд ХЭЗЭЭ Ч битгий тавь — гадаад API дуудлага
# зөвхөн backend-ээс явна.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
